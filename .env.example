# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Search Console verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Sheets lead storage (service account). If unset in development,
# leads are written to data/leads.csv instead.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks, wrapped in double quotes.
GOOGLE_PRIVATE_KEY=

# Admin area (/admin). Generate the hash with:  npm run admin:hash
# Keep these secret: set them only in .env.local or your host's environment settings.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=

# Shared rate limits on Vercel (login lockout + form spam limits).
# Add "Upstash for Redis" from the Vercel Marketplace: it sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically. Or set these two yourself:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
