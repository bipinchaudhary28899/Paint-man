# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search engine ownership codes (optional): the content="..." value of the HTML tag each
# console shows you. Google Search Console, then Bing Webmaster Tools (msvalidate.01).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Database: Postgres (Supabase, Mumbai region). Leads, customer accounts and projects live here.
# Leave both empty for local development: `npm run dev` then uses a local database in data/dev-db
# (PGlite, created and migrated automatically). In production DATABASE_URL is required.
# Pooled connection for the app (Supabase: Connect → Transaction pooler, port 6543).
DATABASE_URL=
# Direct connection for migrations, `npm run db:migrate` (Supabase: Connect → Direct connection,
# or the Session pooler on port 5432 if your network has no IPv6).
DATABASE_URL_DIRECT=

# Sign-in codes by SMS (MSG91). Without these, development prints each code to the server terminal
# and production cannot send codes (customers cannot sign in). The template is your DLT-approved
# OTP message added in MSG91 with its variable written ##otp##.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Admin area (/admin). Generate the hash with:  npm run admin:hash
# Keep these secret: set them only in .env.local or your host's environment settings.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Also keys the hashes of customers' sign-in codes. Changing it signs
# admins out and cancels codes already sent (customers stay signed in).
SESSION_SECRET=

# Shared rate limits on Vercel (login lockout + form spam limits).
# Add "Upstash for Redis" from the Vercel Marketplace: it sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically. Or set these two yourself:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
