{
  "expo": {
    "name": "Paint Saathi",
    "slug": "paint-saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../public/brand/05-app-icon/app-icon-light-1024.png",
    "scheme": "paintsaathi",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#f8f5ef",
    "ios": {
      "bundleIdentifier": "in.paintsaathi.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:paintsaathi.in"
      ]
    },
    "android": {
      "package": "in.paintsaathi.app",
      "adaptiveIcon": {
        "backgroundColor": "#f8f5ef",
        "foregroundImage": "../public/brand/05-app-icon/app-icon-light-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/about"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/book"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/colours"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/contact"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/faq"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/gallery"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/login"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/palettes"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/privacy-policy"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/terms"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/thank-you"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/account"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "pathPrefix": "/account/projects/"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/services"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "pathPrefix": "/services/"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "path": "/shade-cards"
            },
            {
              "scheme": "https",
              "host": "paintsaathi.in",
              "pathPrefix": "/shade-cards/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f5ef"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Paint Saathi uses your location only when you tap \"Use my location\", to fill in the address for your painting inspection.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
